# Игнорировать все файлы и папки
*

# Но разрешить папки (чтобы Git мог заходить в них)
!*/

# Разрешить все файлы с расширением .py
!*.py

# Разрешить сам .gitignore (чтобы он был в репозитории)
!.gitignore

# Явно игнорируем виртуальные окружения (они могут содержать .py файлы)
/venv/
/env/
/.venv/
/virtualenv/

# Дополнительно игнорируем кеш и скомпилированные байт-коды
__pycache__/
*.pyc
*.pyo
*.pyd

# Системные мусорные файлы
.DS_Store
Thumbs.db